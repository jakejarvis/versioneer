{
  "name": "@versioneer/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy --env=production",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --config ../../.oxfmtrc.json",
    "fmt:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@levischuck/tiny-cbor": "^0.3.3",
    "@peculiar/asn1-ecc": "^2.6.1",
    "@peculiar/asn1-schema": "^2.6.0",
    "@peculiar/asn1-x509": "^2.6.1",
    "@versioneer/core": "workspace:*",
    "@versioneer/db": "workspace:*",
    "@versioneer/schemas": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.12.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@versioneer/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
