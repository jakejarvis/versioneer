{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "versioneer-api",
  "main": "src/index.ts",

  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    {
      "pattern": "api.versioneer.app",
      "zone_name": "versioneer.app",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "dev",
    "ASSETS_BASE_URL": "http://localhost:8787/assets"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "versioneer-db-dev",
      "database_id": "0af7b90f-a8b3-4392-8dd9-73b12e3e48ff"
    }
  ],

  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "versioneer-raw-dev"
    },
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "versioneer-assets-dev"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "59fffb96b80a45d586051951e8043f3f"
    },
    {
      "binding": "CONFIG_KV",
      "id": "6d27b272dbd9466fb1d7bcc2ce83f501"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "SOURCE_FETCH_QUEUE",
        "queue": "versioneer-source-fetch-dev"
      },
      {
        "binding": "SOURCE_PARSE_QUEUE",
        "queue": "versioneer-source-parse-dev"
      },
      {
        "binding": "ARTIFACT_VERIFY_QUEUE",
        "queue": "versioneer-artifact-verify-dev"
      },
      {
        "binding": "RECOMPUTE_LATEST_QUEUE",
        "queue": "versioneer-recompute-latest-dev"
      }
    ]
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "ASSETS_BASE_URL": "https://assets.versioneer.app"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "versioneer-db-production",
          "database_id": "ebebaf93-b3a1-4832-b3e7-39845bb7422f"
        }
      ],
      "r2_buckets": [
        {
          "binding": "RAW_BUCKET",
          "bucket_name": "versioneer-raw-production"
        },
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "versioneer-assets-production"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE_KV",
          "id": "fd325c0b363541278f4555a0d43c57be"
        },
        {
          "binding": "CONFIG_KV",
          "id": "babe0cb4a83642b0943226af13862149"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SOURCE_FETCH_QUEUE",
            "queue": "versioneer-source-fetch-production"
          },
          {
            "binding": "SOURCE_PARSE_QUEUE",
            "queue": "versioneer-source-parse-production"
          },
          {
            "binding": "ARTIFACT_VERIFY_QUEUE",
            "queue": "versioneer-artifact-verify-production"
          },
          {
            "binding": "RECOMPUTE_LATEST_QUEUE",
            "queue": "versioneer-recompute-latest-production"
          }
        ]
      }
    }
  }
}
