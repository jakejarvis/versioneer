{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/", "@sofa/"],
    "newlinesBetween": true,
    "order": "asc"
  },
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".turbo",
    ".wrangler",
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "packages/db/migrations"
  ]
}
