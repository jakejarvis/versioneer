{
  "name": "versioneer-mono",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "deploy": "turbo run deploy --concurrency=1",
    "dev": "turbo run dev --filter=@versioneer/api --filter=@versioneer/dashboard",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @versioneer/db db:generate",
    "db:migrate:local": "pnpm --filter @versioneer/db db:migrate:local",
    "db:migrate:remote": "pnpm --filter @versioneer/db db:migrate:remote",
    "cf-typegen": "turbo run cf-typegen"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
