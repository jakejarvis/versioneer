{
  "name": "versioneer-mono",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "deploy": "vp run -r deploy",
    "dev": "vp run --filter @versioneer/api --filter @versioneer/dashboard dev",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "db:generate": "vp run @versioneer/db#db:generate",
    "db:migrate:local": "vp run @versioneer/db#db:migrate:local",
    "db:migrate:remote": "vp run @versioneer/db#db:migrate:remote",
    "cf-typegen": "vp run -r cf-typegen",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.0.8"
}
