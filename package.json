{
  "name": "macupdater",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @macupdater/db generate",
    "db:migrate": "pnpm --filter @macupdater/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@cloudflare/workers-types": "^4.20250109.0"
  }
}
