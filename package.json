{
  "name": "macupdater",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @macupdater/db generate",
    "db:migrate": "pnpm --filter @macupdater/db migrate"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "@cloudflare/workers-types": "^4.20260317.1"
  }
}
