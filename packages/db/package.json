{
  "name": "@versioneer/db",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply versioneer-db-dev --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply versioneer-db-production --remote --env=production"
  },
  "dependencies": {
    "@versioneer/schemas": "workspace:*",
    "drizzle-orm": "catalog:",
    "nanoid": "^5.1.9"
  },
  "devDependencies": {
    "@versioneer/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
