{
  "name": "@versioneer/db",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --config ../../.oxfmtrc.json",
    "fmt:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply versioneer-db-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply versioneer-db-dev --remote"
  },
  "dependencies": {
    "@versioneer/schema": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@versioneer/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2",
    "wrangler": "^4.77.0"
  }
}
