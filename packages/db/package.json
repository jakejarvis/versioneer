{
  "name": "@versioneer/db",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --config ../../.oxfmtrc.json",
    "fmt:check": "oxfmt --check --config ../../.oxfmtrc.json",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply versioneer-db-dev --local"
  },
  "dependencies": {
    "@versioneer/schema": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@versioneer/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
